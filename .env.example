# Copy to .env for Docker Compose. Do not put OAuth secrets in this file.
# Put the Google client file at .meet-notes/secrets/credentials.json
# and the token at .meet-notes/data/token.json (created by `meet-notes auth`).

MEET_NOTES_TIMEZONE=Asia/Karachi
MEET_NOTES_CALENDAR_ID=primary
MEET_NOTES_STAY_MODE=leave_after_notes
MEET_NOTES_JOIN_LEAD_MINUTES=3
# MEET_NOTES_MAX_CONCURRENT_JOINS=4
# MEET_NOTES_WAIT_FOR_PARTICIPANT=false
# MEET_NOTES_ONLY_ORGANIZER_MEETINGS=true
# SMTP password. Never put this in config.yaml.
# MEET_NOTES_SMTP_PASSWORD=
MEET_NOTES_HEADLESS=true
MEET_NOTES_LOG_LEVEL=INFO
